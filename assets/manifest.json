{
	"Name": "Foundry VTT",
	"Description": "Stream Deck actions for Foundry VTT.",
	"Author": "Dan Elbert",
	"Version": "0.6.0",
	"Icon": "icon",
	"Category": "Foundry VTT",
	"CategoryIcon": "icon",
	"PropertyInspectorPath": "pi.html",
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/foundryvtt-streamdeck-plugin"
	},
	"CodePathLin": "x86_64-unknown-linux-gnu/bin/foundryvtt-streamdeck-plugin",
	"OS": [
		{
			"Platform": "linux"
		}
	],
	"Actions": [
		{
			"UUID": "us.elbert.foundryvtt.counter",
			"Name": "Counter",
			"Tooltip": "Increment a counter by a configurable step",
			"Icon": "icon",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "actionDefaultImage",
					"Title": "0"
				}
			]
		},
		{
			"UUID": "us.elbert.foundryvtt.sheet",
			"Name": "Actor Sheet",
			"Tooltip": "Toggle an actor's character sheet and show its token art",
			"Icon": "sheet",
			"PropertyInspectorPath": "pi-sheet.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "actionDefaultImage",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "us.elbert.foundryvtt.condition",
			"Name": "Condition",
			"Tooltip": "Show and toggle a condition on the selected tokens",
			"Icon": "condition",
			"PropertyInspectorPath": "pi-condition.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "actionDefaultImage",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"UUID": "us.elbert.foundryvtt.initiative",
			"Name": "Initiative",
			"Tooltip": "Start combat with the selected tokens, or show and open the current combatant",
			"Icon": "initiative",
			"PropertyInspectorPath": "pi-initiative.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "actionDefaultImage",
					"TitleAlignment": "bottom"
				}
			]
